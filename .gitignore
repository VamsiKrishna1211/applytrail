# binaries
/bin/
/dist/
# anchored: unanchored, these match the cmd/applytrail and
# cmd/applytrail-server directories and silently hide new source files
/applytrail
/applytrail-server

# env / secrets
.env
.env.local
*.pem

# go
*.test
*.out
coverage.*

# editors / os
.DS_Store
.idea/
.vscode/

# the browser client's bundle: built by `make web`, embedded under -tags webui
/internal/transport/webui/dist/
/web/node_modules/
/web/*.tsbuildinfo

# generated by a local docs preview; the site is built by Actions
/docs/Gemfile.lock
/docs/.jekyll-cache/
/docs/_site/

# local tooling scratch, not part of the project
/.agents/
/.neon
/skills-lock.json
# backups of the local env file carry the same secrets it does
.env.local.*
