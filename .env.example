# Copy to .env for shared defaults. Machine-specific overrides go in
# .env.local, which the Makefile includes last and which therefore wins —
# handy for pointing a laptop at the local docker postgres while .env points
# at a deployed database. Both files are gitignored.
#
# An API key exists only in the database it was created in. If `apikey create`
# and `run` disagree about which that is, the key authenticates against
# neither.

# --- server ---
APPLYTRAIL_ADDR=:8080
APPLYTRAIL_ENV=development          # development | production
APPLYTRAIL_LOG_LEVEL=info           # debug | info | warn | error

# --- database ---
# local docker compose default; override with a Neon URL in production
APPLYTRAIL_DATABASE_URL=postgres://applytrail:applytrail@localhost:5432/applytrail?sslmode=disable
APPLYTRAIL_DB_MAX_CONNS=8
APPLYTRAIL_DB_MIN_CONNS=0

# --- dedupe tuning ---
APPLYTRAIL_FUZZY_MATCH_THRESHOLD=0.87
APPLYTRAIL_FUZZY_REVIEW_THRESHOLD=0.75

# --- rate limiting (per API key) ---
APPLYTRAIL_RATE_LIMIT_RPM=120
APPLYTRAIL_RATE_LIMIT_BURST=60

# --- observability ---
# leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry export entirely
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=applytrail
